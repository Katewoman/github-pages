<!DOCTYPE html>
<html>
<head>
    <title>Gestion Devis</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body { 
            padding: 20px;
            font-family: Arial;
        }
        form {
            max-width: 500px;
            margin: auto;
        }
        input, textarea {
            width: 100%;
            padding: 8px;
            margin: 8px 0;
        }
        button {
            background: #4CAF50;
            color: white;
            padding: 10px;
            border: none;
            width: 100%;
        }
    </style>
</head>
<body>
    <form id="devisForm">
        <h2>Nouveau Devis</h2>
        
        <label>Client</label>
        <input type="text" name="client" required>
        
        <label>Email</label>
        <input type="email" name="email" required>
        
        <label>Description</label>
        <textarea name="description" rows="3"></textarea>
        
        <label>Montant (€)</label>
        <input type="number" name="montant" required>
        
        <button type="submit">Créer Devis</button>
    </form>

    <script>
        document.getElementById('devisForm').onsubmit = function(e) {
            e.preventDefault();
            const formData = new FormData(e.target);
            
            fetch('VOTRE_URL_GOOGLE_SCRIPT', {
                method: 'POST',
                body: JSON.stringify(Object.fromEntries(formData))
            })
            .then(response => alert('Devis enregistré !'))
            .catch(error => alert('Erreur'));
        };
    </script>
</body>
</html>
